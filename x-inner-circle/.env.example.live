# Live / Vercel — start with very low limits for safe testing
X_BEARER_TOKEN=
X_API_BASE_URL=https://api.x.com/2

# Tight scan caps (raise after validating live mode)
X_MAX_POSTS_PER_SCAN=10
X_MAX_MENTIONS_PER_SCAN=10
X_MAX_PROFILE_LOOKUPS_PER_SCAN=10
X_MAX_PAGINATION_REQUESTS_PER_SCAN=2
X_MAX_API_REQUESTS_PER_SCAN=8
X_MAX_RESULTS_PER_RING=20
X_ANALYSIS_DAYS=30

ENABLE_MOCK_MODE=false
ENABLE_LIVE_X_API=true

# Client must call server API routes (not browser mock)
NEXT_PUBLIC_USE_CLIENT_MOCK=false
NEXT_PUBLIC_BASE_PATH=
NEXT_PUBLIC_APP_URL=https://your-project.vercel.app
