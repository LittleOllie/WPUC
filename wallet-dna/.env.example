# Server only — never NEXT_PUBLIC_
# Copy this file to .env.local and add your Alchemy key (do not commit real keys here).
ALCHEMY_API_KEY=
ALCHEMY_API_KEY_WALLET_DNA=

# Optional overrides
WALLET_DNA_CACHE_TTL_SECONDS=21600
WALLET_DNA_MAX_TRANSFERS_PER_CHAIN=5000
WALLET_DNA_USE_FIXTURES=false

# Client (public)
NEXT_PUBLIC_BASE_PATH=/wallet-dna
NEXT_PUBLIC_SITE_URL=https://littleollielabs.com
NEXT_PUBLIC_WALLET_DNA_API_BASE=
